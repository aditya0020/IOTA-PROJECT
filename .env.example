DATABASE_PATH=data/supply_chain.sqlite3
# Generate separate long random tokens; do not use these placeholders.
DEVICE_API_KEY=replace-with-random-device-token
ADMIN_API_KEY=replace-with-random-admin-token
CHECKPOINT_INTERVAL=10
BLOCKCHAIN_ENABLED=false
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_CHAIN_ID=31337
BLOCKCHAIN_DEPLOYMENT=blockchain/deployment.json
# Local Hardhat only: index of an unlocked development account.
BLOCKCHAIN_ACCOUNT_INDEX=1
# For a signed account, set a private key instead of an unlocked account.
BLOCKCHAIN_PRIVATE_KEY=
BLOCKCHAIN_CONTRACT_ADDRESS=
BLOCKCHAIN_EXPLORER_URL=
BLOCKCHAIN_ANCHOR_EVERY_N_READINGS=1
BLOCKCHAIN_ANCHOR_ALERTS_IMMEDIATELY=true
# Sepolia deployer administers roles; the backend wallet is a distinct writer.
SEPOLIA_RPC_URL=
DEPLOYER_PRIVATE_KEY=
BLOCKCHAIN_WRITER_ADDRESS=
# Allowed VS Code Live Server origins; comma-separated, no trailing slashes.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:5501,http://localhost:5501
